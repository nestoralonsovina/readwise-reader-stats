meta {
  name: Get Book Tag
  type: http
  seq: 2
}

get {
  url: https://readwise.io/api/v2/books/:book_id/tags/:tag_id
  body: none
  auth: none
}

headers {
  Authorization: Token {{ACCESS_TOKEN}}
}

params:path {
  book_id: book-id-here
  tag_id: tag-id-here
}

docs {
  Get a specific tag for a book/source.

  Path parameters:
  - book_id: The book ID
  - tag_id: The tag ID

  Returns the tag object.
}
