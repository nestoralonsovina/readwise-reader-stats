meta {
  name: List Tags
  type: http
  seq: 1
}

get {
  url: https://readwise.io/api/v3/tags/
  body: none
  auth: none
}

headers {
  Authorization: Token {{ACCESS_TOKEN}}
}

params:query {
  ~pageCursor: cursor-string
}

docs {
  List all tags from Readwise Reader.

  Query parameters (optional):
  - pageCursor: Pagination cursor from previous response

  Response includes:
  - count: Total number of tags
  - nextPageCursor: Cursor for next page (null if no more pages)
  - results: Array of tag objects with key and name
}
