meta {
  name: Update Highlight Tag
  type: http
  seq: 4
}

patch {
  url: https://readwise.io/api/v2/highlights/:highlight_id/tags/:tag_id
  body: json
  auth: none
}

headers {
  Authorization: Token {{ACCESS_TOKEN}}
  Content-Type: application/json
}

params:path {
  highlight_id: highlight-id-here
  tag_id: tag-id-here
}

body:json {
  {
    "name": "updated-tag-name"
  }
}

docs {
  Update a tag on a highlight.

  Path parameters:
  - highlight_id: The highlight ID
  - tag_id: The tag ID

  Body:
  - name: New tag name (max 127 characters)

  Returns the updated tag object.
}
