meta {
  name: Delete Highlight Tag
  type: http
  seq: 5
}

delete {
  url: https://readwise.io/api/v2/highlights/:highlight_id/tags/:tag_id
  body: none
  auth: none
}

headers {
  Authorization: Token {{ACCESS_TOKEN}}
}

params:path {
  highlight_id: highlight-id-here
  tag_id: tag-id-here
}

docs {
  Remove a tag from a highlight.

  Path parameters:
  - highlight_id: The highlight ID
  - tag_id: The tag ID

  Returns 204 (No Content) on success.
}
