meta {
  name: List Highlights
  type: http
  seq: 2
}

get {
  url: https://readwise.io/api/v2/highlights/
  body: none
  auth: none
}

headers {
  Authorization: Token {{ACCESS_TOKEN}}
}

params:query {
  ~page_size: 100
  ~page: 1
  ~book_id: 12345
  ~updated__lt: 2024-12-31T23:59:59Z
  ~updated__gt: 2024-01-01T00:00:00Z
  ~highlighted_at__lt: 2024-12-31T23:59:59Z
  ~highlighted_at__gt: 2024-01-01T00:00:00Z
}

docs {
  List highlights from Readwise.

  Query parameters (all optional):
  - page_size: Number of results per page (max 1000)
  - page: Page number
  - book_id: Filter by specific book/source ID
  - updated__lt: Updated before timestamp (ISO 8601)
  - updated__gt: Updated after timestamp (ISO 8601)
  - highlighted_at__lt: Highlighted before timestamp
  - highlighted_at__gt: Highlighted after timestamp

  Response includes:
  - count: Total number of highlights
  - next/previous: Pagination URLs
  - results: Array of highlight objects with tags

  Rate limit: 20 requests/minute
}
